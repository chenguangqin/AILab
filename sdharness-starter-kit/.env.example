# sdharness-starter-kit — environment
# Copy to .env and adjust. The harness forwards these to the Claude Code coding agent.

# Route the coding agent through Amazon Bedrock (this kit is Bedrock-only).
CLAUDE_CODE_USE_BEDROCK=1

# AWS auth for Bedrock. Use whichever your environment provides (profile or keys).
# Region is intentionally NOT pinned — the kit is region-agnostic and uses your ambient
# AWS region (AWS_REGION / AWS_DEFAULT_REGION, or your profile's default). Uncomment and
# set one only to override, e.g. AWS_REGION=us-west-2.
# AWS_REGION=us-east-1
AWS_PROFILE=default

# Inner harness — the coding agent (generator). A `global.` cross-region inference
# profile, so it resolves from any region with Bedrock access to that model. Opus for
# the heavy build work. Whichever id you set must be enabled in your account's Bedrock
# model access; swap it for one you can invoke if needed.
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-6-v1

# Outer harness — the steering "Pilot" (evaluator). Sonnet is plenty for GO/NO_GO
# review, and keeping it distinct from the coding agent preserves the generator ≠
# evaluator split. Falls back to ANTHROPIC_MODEL if unset.
HARNESS_STEERING_MODEL=global.anthropic.claude-sonnet-4-6
